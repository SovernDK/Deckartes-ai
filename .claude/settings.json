{
  "permissions": {
    "allow": [
      "Bash(rapid-mlx --help)",
      "Bash(rapid-mlx models)",
      "Bash(rapid-mlx info *)",
      "Bash(rapid-mlx serve *)",
      "Bash(curl http://127.0.0.1:8000/*)",
      "Read(~/.local/share/uv/tools/rapid-mlx/**)",
      "Bash(venv/bin/python -m unittest *)",
      "Bash(venv/bin/pip uninstall -y ollama)",
      "Bash(rm ollama_client.py ollama_api.py tests/test_ollama_client.py)",
      "Bash(curl http://127.0.0.1:8001/*)"
    ],
    
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(**/CLAUDE.md)"
    ]
  },
  
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-scanner.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-code.py",
            "timeout": 300,
            "statusMessage": "Formatting, linting and testing..."
          }
        ]
      }
    ]
  }
}
