# Copy to .env and fill in the values.

# Web search tools (Ollama web API)
OLLAMA_API_KEY=

# Anime tools (AnimeSchedule.net)
ANIMESCHEDULE_TOKEN=

# Counter-Strike tools (PandaScore)
PANDA_SCORE_API_TOKEN=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Bank tools (Enable Banking): application id and path of its private key (.pem)
ENABLE_BANKING_APP_ID=
# Relative to the repo folder (private/key.pem) or absolute; keep the .pem out of git
ENABLE_BANKING_KEY_PATH=

# The sandbox app (made-up banks), for testing; used instead of the one above with ENABLE_BANKING_SANDBOX=1
ENABLE_BANKING_SANDBOX_ID=
ENABLE_BANKING_SANDBOX_KEY_PATH=
ENABLE_BANKING_SANDBOX=
